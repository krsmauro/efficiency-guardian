#!/bin/zsh -f
# efficiency-guardian: punto de entrada del motor de bloqueo.
#
# Uso: guardian start | stop | status
#
# Este archivo solo prepara un entorno seguro, carga los módulos de lib/ y
# despacha el subcomando. La lógica vive en los módulos.
#
# Seguridad (start y stop corren como root, vía sudo):
# - El "-f" de la primera línea impide que zsh lea ~/.zshenv y los demás archivos
#   de arranque del usuario. Sin él, como sudo en macOS conserva HOME, zsh
#   ejecutaría como root el ~/.zshenv del usuario.
# - Siendo root, los módulos se cargan SOLO desde una ruta fija, y antes se
#   comprueba que nadie más que root puede modificarlos. Nunca desde $0, una
#   ruta relativa o una variable de entorno.
# - Sin root (pruebas), GUARDIAN_LIB_DIR elige la carpeta de módulos.

emulate -R zsh
setopt ERR_EXIT NO_UNSET PIPE_FAIL
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 022

readonly INSTALLED_LIB=/usr/local/libexec/efficiency-guardian/lib
readonly MODULES=(env log blocklist hosts-block hosts-write cmd-start cmd-stop cmd-status)

# Error antes de tener log.zsh cargado.
early_die() {
  print -ru2 -- "guardian: error: $*"
  exit 1
}

# Aborta si la ruta no es de root, es un enlace o la pueden escribir el grupo u otros.
# (install/verify.zsh hace la misma comprobación al instalar.)
require_root_only() {
  local target=$1 owner mode
  if [[ ! -e $target || -L $target ]]; then early_die "falta o es un enlace: $target"; fi
  owner=$(stat -f %u -- $target)
  mode=$(stat -f %Lp -- $target)
  if (( owner != 0 || (8#$mode & 8#022) != 0 )); then
    early_die "inseguro: $target debe ser de root y no escribible por otros (dueño $owner, permisos $mode)"
  fi
}

if (( EUID == 0 )); then
  lib_dir=$INSTALLED_LIB
  for dir in /usr/local /usr/local/libexec ${lib_dir:h} $lib_dir; do
    require_root_only $dir
  done
  for module in $MODULES; do
    require_root_only $lib_dir/$module.zsh
  done
else
  lib_dir=${GUARDIAN_LIB_DIR:-$INSTALLED_LIB}
fi

for module in $MODULES; do
  if [[ ! -r $lib_dir/$module.zsh ]]; then
    early_die "no se encuentra el módulo $lib_dir/$module.zsh (¿está instalado?)"
  fi
  source $lib_dir/$module.zsh
done

usage() {
  print -ru2 -- "Uso: guardian start | stop | status"
  print -ru2 -- "  start   bloquea los sitios de las listas (necesita sudo)"
  print -ru2 -- "  stop    quita el bloqueo (necesita sudo)"
  print -ru2 -- "  status  dice si el bloqueo está activo"
  exit 2
}

if (( $# != 1 )); then usage; fi
case $1 in
  start)  cmd_start ;;
  stop)   cmd_stop ;;
  status) cmd_status ;;
  *)      usage ;;
esac
